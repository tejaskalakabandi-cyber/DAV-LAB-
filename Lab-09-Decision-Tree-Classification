      "2\n"
     ]
    }
   ],
   "source": [
    "# Step 3: Separate Input Features and Target\n",
    "X = df[[\"Study_Hours\", \"Attendance\"]]\n",
    "y = df[\"Result\"]\n",
    "\n",
    "# Step 4: Split Dataset into Training and Testing Data\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X,\n",
    "    y,\n",
    "    test_size=0.25,\n",
    "    random_state=42,\n",
    "    stratify=y\n",
    ")\n",
    "\n",
    "print(\"\\nTraining Records:\")\n",
    "print(len(X_train))\n",
    "\n",
    "print(\"\\nTesting Records:\")\n",
    "print(len(X_test))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "3f1058c7-24de-4289-95cf-2f23e6b61f09",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Decision Tree Model Trained Successfully!\n"
     ]
    }
   ],
   "source": [
    "# Step 5: Create Decision Tree Classifier\n",
    "model = DecisionTreeClassifier(\n",
    "    criterion=\"gini\",\n",
    "    max_depth=2,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "# Step 6: Train the Model\n",
    "model.fit(X_train, y_train)\n",
    "\n",
    "print(\"\\nDecision Tree Model Trained Successfully!\")"
   ]
  },
